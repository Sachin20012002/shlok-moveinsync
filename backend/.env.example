# Local development:
DATABASE_URL=sqlite:///./mobility.db
# Active cloud provider: Neon PostgreSQL. Keep the real URL only in .env:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@NEON_HOST/DATABASE?sslmode=require&channel_binding=require
REFERENCE_DATA_DIR=../MoveInSync - Anonymised Trip-Log Dataset
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTA_SLA=90
OTA_GRACE_MINUTES=5
MINIMUM_COMPLETED_TRIPS=10
VENDOR_MINIMUM_COMPLETED_TRIPS=3
GPS_AVAILABILITY_SLA=95
INCIDENT_REOPEN_DROP_POINTS=5
AI_PROVIDER=sarvam
AI_API_KEY=
AI_BASE_URL=https://api.sarvam.ai
AI_MODEL=sarvam-105b
