# Local development:
DATABASE_URL=sqlite:///./mobility.db
# Cloud PostgreSQL example (keep the real value only in .env):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REFERENCE_DATA_DIR=../MoveInSync - Anonymised Trip-Log Dataset
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTA_SLA=90
OTA_GRACE_MINUTES=5
MINIMUM_COMPLETED_TRIPS=10
VENDOR_MINIMUM_COMPLETED_TRIPS=3
GPS_AVAILABILITY_SLA=95
INCIDENT_REOPEN_DROP_POINTS=5
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini