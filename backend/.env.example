# Neon: copy the complete connection string and keep any compatible query parameters.
# Both postgresql:// and postgresql+psycopg:// are accepted; SQLAlchemy uses psycopg 3.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR_NEON_HOST/DATABASE?sslmode=require
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTA_SLA=90
OTA_GRACE_MINUTES=5
MINIMUM_COMPLETED_TRIPS=10
VENDOR_MINIMUM_COMPLETED_TRIPS=3
GPS_AVAILABILITY_SLA=95
INCIDENT_REOPEN_DROP_POINTS=5
